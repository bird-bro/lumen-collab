{
  "permissions": {
    "allow": [
      "Bash(openspec:*)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(mvn:*)",
      "Bash(gradle:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "echo '[loopforge] session started'" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write", "hooks": [ { "type": "command", "command": "echo '[loopforge] pre-edit gate'" } ] }
    ],
    "Stop": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "echo '[loopforge] session stop'" } ] }
    ]
  }
}
