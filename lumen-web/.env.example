# lumen-web environment example (copy to .env.local and adjust - *.local is gitignored).
#
# VITE_API_ENTRY_URL retargets the vite dev proxy (/api/v1 -> the entry) WITHOUT any
# source change (web-app-shell spec: Direct-service preview override). The default when
# unset is the unified nginx entry on :80 (hospital deployment form).
#
# Day-to-day development against a locally booted lumen-system (no nginx) - the form
# most developers want:
VITE_API_ENTRY_URL=http://localhost:8081
