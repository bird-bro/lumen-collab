node_modules/
dist/
build/
target/
*.log
.DS_Store
.env
.env.*
!.env.example
!*/.env.example
.idea/
*.iml
.vscode/
coverage/

# Maven flatten plugin output
.flattened-pom.xml
*.local
docker/.env
lumen-sev/.env-test.local
lumen-sev/lumen-system/src/main/resources/application-dev.yml

# SQL handoff artifacts are tracked despite the machine-level global *.sql ignore
# (docs/deployment/pg-init.sql is referenced by the environment-contract spec; a
# directory-scoped negation already covers Flyway migrations under lumen-sev).
!docs/deployment/*.sql

# Backend run-log dirs (test-context output). The machine-global bare `logs` ignore
# was removed 2026-11-05 (it had silently untracked lumen-web/src/pages/system/logs/),
# so runtime logs need this explicit repo rule instead.
lumen-sev/logs/
lumen-sev/*/logs/

# Smoke-test runtime artifacts (lumen-system upload.home writes)
lumen-sev/upload/
