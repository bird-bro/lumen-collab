<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.birdbro</groupId>
        <artifactId>lumen-sev</artifactId>
        <version>${revision}</version>
    </parent>

    <name>${project.artifactId}</name>
    <artifactId>lumen-setting</artifactId>
    <packaging>jar</packaging>

    <dependencies>

        <!-- lumen shared base, copied verbatim from OPS. Dependency shape mirrors
             lumen-system 1:1 (exam-setting-api D1) so every service classpath stays
             interchangeable - the bcprov exclusion keeps exactly ONE BouncyCastle on
             the classpath even though this service runs no SM2 of its own. -->
        <dependency>
            <groupId>org.birdbro</groupId>
            <artifactId>framework</artifactId>
        </dependency>
        <dependency>
            <groupId>org.birdbro</groupId>
            <artifactId>common</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.bouncycastle</groupId>
                    <artifactId>bcprov-jdk16</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
        </dependency>

        <!-- web (Servlet stack - no reactive deps may enter) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- bean validation for the DTO contracts (same justification as lumen-system) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- No registry/config center (user decision 2026-11-03, local configuration -
             the fu-launch shape; see lumen-system's pom for the full note). -->

        <!-- Flyway: migrations execute against the team test server's lumen database.
             Version managed by Boot's dependency management (2.5.15 -> flyway-core 7.7.3). -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- commons-pool2 for lettuce pooling parity (see lumen-system's pom note) -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
