<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.birdbro</groupId>
        <artifactId>lumen-sev</artifactId>
        <version>${revision}</version>
    </parent>

    <name>${project.artifactId}</name>
    <artifactId>lumen-system</artifactId>
    <packaging>jar</packaging>

    <dependencies>

        <!-- lumen shared base, copied verbatim from OPS (init-backend-skeleton Batch 2).
             Redis arrives transitively via framework/common's spring-boot-starter-data-redis;
             the conditional RedisConfig (adaptation (a)) keeps it harmless without a server. -->
        <dependency>
            <groupId>org.birdbro</groupId>
            <artifactId>framework</artifactId>
        </dependency>
        <dependency>
            <groupId>org.birdbro</groupId>
            <artifactId>common</artifactId>
            <!-- OPS common carries bcprov-jdk16 1.46 (RSAUtils' provider registration
                 only - lumen-system never calls it). Hutool SM2 (password-crypto)
                 needs the modern provider; the two jars share org.bouncycastle packages,
                 so jdk16 is EXCLUDED here to keep exactly ONE BC on this service's
                 classpath (password-transport-encryption-api D9; common/pom.xml and
                 every other module are untouched). -->
            <exclusions>
                <exclusion>
                    <groupId>org.bouncycastle</groupId>
                    <artifactId>bcprov-jdk16</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Modern BouncyCastle provider for Hutool 5.8.20 SM2 (password-transport-
             encryption-api, coordination D9). Version managed by lumen-bom's additive pin. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
        </dependency>

        <!-- web (Servlet stack - no reactive deps may enter) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- bean validation: common brings only validation-api (no implementation), so
             the @NotBlank contract of the login/create-user DTOs needs the hibernate
             validator - version managed by Boot's dependency management (task 3.1) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- No registry/config center since user decision 2026-11-03 (随访 fu-launch
             shape, design D8): configuration is local - committed application.yml
             (framework-demanded token/xss/dispose values) plus the GITIGNORED
             application-dev.yml for credentials (template: application-dev.yml.example).
             The OPS-train nacos-discovery/nacos-config/bootstrap starters were removed
             here; lumen-bom keeps managing the versions for any future cloud-form change. -->

        <!-- Flyway: migrations execute against the team test server's lumen database
             (auth-rbac-foundation task 1.2, design D3). Version managed by Boot's
             dependency management (2.5.15 -> flyway-core 7.7.3) - no version tag. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- commons-pool2: required by Spring Data Redis lettuce POOLING, which the
             local-config application-dev.yml enables (spring.redis.lettuce.pool, the
             随访 fu shape - fu_sev carries the same artifact in its framework pom).
             lumen keeps the verbatim-copy discipline on framework, so the service owns
             it. Version managed by Boot's dependency management - no version tag. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
