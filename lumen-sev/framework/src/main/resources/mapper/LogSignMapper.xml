<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.birdbro.framework.log.mapper.LogSignMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="org.birdbro.framework.log.entity.LogSignEntity">
        <result column="date_ym" property="dateYm"/>
        <result column="create_time" property="createTime"/>
        <result column="deleted" property="deleted"/>
        <result column="id" property="id"/>
        <result column="msg" property="msg"/>
        <result column="descr" property="descr"/>
        <result column="type" property="type"/>
        <result column="uid" property="uid"/>
        <result column="account" property="account"/>
        <result column="action_time" property="actionTime"/>
        <result column="mobile" property="mobile"/>
        <result column="ip" property="ip"/>
        <result column="os" property="os"/>
        <result column="browser" property="browser"/>
        <result column="engine" property="engine"/>
        <result column="session" property="session"/>
        <result column="token" property="token"/>
        <result column="app" property="app"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        date_ym,
        create_time,
        deleted,
        id, msg, descr, type, uid, account, action_time, mobile, ip, os, browser, engine, session, token, app
    </sql>

    <select id="getLogSignPage" parameterType="org.birdbro.framework.log.request.LogRequest" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"></include>
            FROM log_sign
        WHERE deleted = 0
        <if test="req.account!= null and req.account!= ''">
            AND account = #{req}
        </if>
        <if test="req.operateStartTime != null and req.operateEndTime != ''">
            AND (action_time BETWEEN to_timestamp(#{req.operateStartTime}, 'YYYY-MM-DD HH24:MI:MS')
            AND to_timestamp(#{req.operateEndTime}, 'YYYY-MM-DD HH24:MI:MS'))
        </if>
        ORDER BY action_time DESC
    </select>


    <insert id="insertSign" parameterType="org.birdbro.framework.log.entity.LogSignEntity">
        INSERT INTO log_sign (
                                  date_ym,msg,descr,type,uid,account,action_time,mobile,ip,os,
                                  browser,engine,session,token,app
                                  )
        VALUES (
                #{entity.dateYm},#{entity.msg},#{entity.descr},#{entity.type},#{entity.uid},#{entity.account},
                #{entity.actionTime},#{entity.mobile},#{entity.ip},#{entity.os},#{entity.browser},#{entity.engine},
                #{entity.session},#{entity.token},#{entity.app}
                )
    </insert>







</mapper>
